{
  "name": "Boussole 4C - Admin Design System",
  "version": "1.0.0",
  "description": "Design system complet pour l'interface d'administration",
  "colors": {
    "background": {
      "main": "bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950",
      "sidebar": "bg-slate-900/50 backdrop-blur-xl",
      "card": "bg-slate-800/50 backdrop-blur-sm",
      "input": "bg-slate-900/50",
      "hover": "bg-slate-800/50"
    },
    "brand": {
      "primary": {
        "gradient": "bg-gradient-to-r from-teal-500 to-teal-600",
        "hover": "from-teal-400 to-teal-500",
        "solid": "#14b8a6",
        "light": "teal-500/20",
        "shadow": "shadow-teal-500/20"
      },
      "logo": "bg-gradient-to-br from-teal-400 to-teal-600"
    },
    "text": {
      "primary": "text-white",
      "secondary": "text-slate-400",
      "muted": "text-slate-500",
      "link": "text-teal-400"
    },
    "border": {
      "default": "border-slate-700/50",
      "hover": "border-teal-500/20",
      "active": "border-teal-500"
    },
    "status": {
      "success": {
        "bg": "bg-emerald-500/20",
        "border": "border-emerald-500/30",
        "text": "text-emerald-300"
      },
      "error": {
        "bg": "bg-red-500/20",
        "border": "border-red-500/30",
        "text": "text-red-300"
      },
      "warning": {
        "bg": "bg-amber-500/20",
        "border": "border-amber-500/30",
        "text": "text-amber-300"
      },
      "info": {
        "bg": "bg-blue-500/10",
        "border": "border-blue-500/20",
        "text": "text-blue-400"
      }
    }
  },
  "typography": {
    "headings": {
      "h1": "text-3xl font-bold text-white",
      "h2": "text-lg font-semibold text-white",
      "h3": "text-base font-medium text-white"
    },
    "body": {
      "default": "text-slate-300",
      "small": "text-sm text-slate-400",
      "tiny": "text-xs text-slate-500"
    },
    "labels": {
      "form": "text-sm font-medium text-slate-300 mb-2",
      "uppercase": "text-xs font-semibold text-slate-500 uppercase tracking-wider"
    }
  },
  "spacing": {
    "page": "p-8",
    "section": "mb-8",
    "card": "p-6",
    "cardLarge": "p-8",
    "gap": {
      "small": "gap-2",
      "default": "gap-4",
      "large": "gap-6"
    }
  },
  "borderRadius": {
    "small": "rounded-lg",
    "default": "rounded-xl",
    "large": "rounded-2xl",
    "full": "rounded-full"
  },
  "shadows": {
    "card": "shadow-lg",
    "button": "shadow-lg shadow-teal-500/20",
    "buttonHover": "shadow-teal-500/30"
  },
  "components": {
    "sidebar": {
      "width": {
        "expanded": "w-72",
        "collapsed": "w-20"
      },
      "transition": "transition-all duration-300 ease-in-out",
      "border": "border-r border-slate-800/50"
    },
    "navItem": {
      "default": "flex items-center gap-3 px-3 py-3 rounded-xl transition-all duration-200 text-slate-400 hover:bg-slate-800/50 hover:text-white",
      "active": "bg-gradient-to-r from-teal-500/20 to-teal-600/10 text-teal-400 border border-teal-500/20",
      "iconHover": "group-hover:scale-110 transition-transform"
    },
    "card": {
      "base": "bg-slate-800/50 backdrop-blur-sm rounded-2xl border border-slate-700/50",
      "padding": "p-6",
      "header": "flex items-center gap-3 mb-6"
    },
    "button": {
      "primary": {
        "base": "px-6 py-3 bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-semibold rounded-xl shadow-lg shadow-teal-500/30 transition-all",
        "hover": "hover:from-teal-400 hover:to-cyan-400 hover:shadow-teal-500/40",
        "disabled": "disabled:opacity-50 disabled:cursor-not-allowed"
      },
      "secondary": {
        "base": "px-4 py-2 bg-slate-800/50 hover:bg-slate-800 text-slate-300 hover:text-white rounded-lg transition-colors"
      },
      "danger": {
        "base": "text-red-400 hover:bg-red-500/10 transition-all"
      },
      "icon": {
        "size": "w-10 h-10 rounded-xl flex items-center justify-center"
      }
    },
    "input": {
      "base": "w-full px-4 py-3 bg-slate-900/50 border border-slate-700 rounded-xl text-white outline-none transition-all",
      "focus": "focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20",
      "disabled": "disabled:text-slate-400 disabled:cursor-not-allowed",
      "placeholder": "placeholder:text-slate-500"
    },
    "table": {
      "header": "text-xs font-semibold text-slate-400 uppercase tracking-wider",
      "row": "border-b border-slate-800/50 hover:bg-slate-800/30 transition-colors",
      "cell": "px-4 py-4"
    },
    "badge": {
      "success": "bg-emerald-500/20 text-emerald-400 px-3 py-1 text-xs font-medium rounded-lg",
      "warning": "bg-amber-500/20 text-amber-400 px-3 py-1 text-xs font-medium rounded-lg",
      "error": "bg-red-500/20 text-red-400 px-3 py-1 text-xs font-medium rounded-lg",
      "info": "bg-blue-500/20 text-blue-400 px-3 py-1 text-xs font-medium rounded-lg"
    },
    "iconBox": {
      "colors": {
        "blue": "w-10 h-10 bg-blue-500/20 rounded-xl flex items-center justify-center",
        "purple": "w-10 h-10 bg-purple-500/20 rounded-xl flex items-center justify-center",
        "amber": "w-10 h-10 bg-amber-500/20 rounded-xl flex items-center justify-center",
        "teal": "w-10 h-10 bg-teal-500/20 rounded-xl flex items-center justify-center"
      }
    }
  },
  "animations": {
    "loader": {
      "spinner": "animate-spin h-16 w-16 border-4 border-teal-500/30 border-t-teal-500 rounded-full",
      "pulse": "animate-pulse"
    },
    "transitions": {
      "default": "transition-all duration-200",
      "slow": "transition-all duration-300",
      "sidebar": "transition-all duration-300 ease-in-out"
    },
    "hover": {
      "scale": "hover:scale-105",
      "scaleSmall": "hover:scale-[1.02]",
      "lift": "hover:-translate-y-1"
    }
  },
  "layout": {
    "maxWidth": "max-w-4xl",
    "grid": {
      "twoCol": "grid md:grid-cols-2 gap-4",
      "threeCol": "grid md:grid-cols-3 gap-4"
    },
    "flex": {
      "between": "flex items-center justify-between",
      "center": "flex items-center justify-center",
      "gap": "flex items-center gap-3"
    }
  },
  "header": {
    "topBar": "bg-slate-900/30 backdrop-blur-sm border-b border-slate-800/50 px-6 py-4",
    "time": "text-sm font-medium text-white",
    "date": "text-sm text-slate-500"
  },
