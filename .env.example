# Mot de passe admin pour accéder au panel d'administration
# Choisissez un mot de passe solide
ADMIN_PASSWORD=

# Secret de signature des sessions (OPTIONNEL).
# Les sessions sont des cookies signés (sans stockage serveur) : elles
# survivent aux redémarrages/déploiements. Par défaut, la signature utilise
# ADMIN_PASSWORD. Définir SESSION_SECRET permet de garder les sessions valides
# même si vous changez le mot de passe admin. Générer : openssl rand -hex 32
SESSION_SECRET=

# Brevo (ex-Sendinblue) - Envoi d'emails
# Obtenir sur : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Boussole 4C

# Email destinataire des messages de contact
CONTACT_EMAIL=

# ─── Backup automatique Git (OPTIONNEL) ───────────────────────────────
# Si renseigné, chaque modification sauvegarde automatiquement toutes les
# données (JSON) dans un fichier d'un dépôt GitHub. Au démarrage, si les
# données locales sont absentes (ex. redéploiement), elles sont restaurées
# automatiquement depuis ce backup → persistance même sur hébergement éphémère.
# Le token doit avoir le droit "contents:write" sur le dépôt.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=        # format "owner/repo"
BACKUP_GITHUB_BRANCH=main
BACKUP_GITHUB_PATH=backups/data.json
