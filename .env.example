# Clé secrète pour protéger les routes d'écriture (POST/PUT/DELETE/backup)
# Générer avec : openssl rand -hex 32
API_SECRET_KEY=

# Brevo (ex-Sendinblue) - Envoi d'emails
# Obtenir sur : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Boussole 4C

# Email destinataire des messages de contact
CONTACT_EMAIL=
