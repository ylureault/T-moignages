{
  "name": "Boussole 4C - Front-end Design System",
  "version": "1.0.0",
  "description": "Design system complet pour l'interface publique (diagnostic, résultats, landing)",
  "colors": {
    "background": {
      "dark": {
        "gradient": "bg-gradient-to-br from-slate-900 via-slate-800 to-teal-900",
        "solid": "bg-slate-900"
      },
      "light": {
        "gradient": "bg-gradient-to-br from-slate-50 via-white to-teal-50/30",
        "solid": "bg-slate-50",
        "white": "bg-white"
      },
      "glass": {
        "dark": "bg-white/10 backdrop-blur-sm",
        "light": "bg-white/80 backdrop-blur-xl"
      }
    },
    "brand": {
      "primary": {
        "gradient": "bg-gradient-to-r from-teal-500 to-cyan-500",
        "gradientHover": "from-teal-400 to-cyan-400",
        "solid": "#14b8a6",
        "hex": {
          "teal500": "#14b8a6",
          "teal600": "#0d9488",
          "cyan500": "#06b6d4"
        }
      },
      "secondary": {
        "gradient": "bg-gradient-to-br from-teal-400 to-teal-600"
      }
    },
    "axes": {
      "cap": {
        "color": "#3b82f6",
        "gradient": "from-blue-500 to-indigo-600",
        "bg": "bg-blue-500"
      },
      "contraintes": {
        "color": "#f59e0b",
        "gradient": "from-amber-500 to-orange-600",
        "bg": "bg-amber-500"
      },
      "capacites": {
        "color": "#10b981",
        "gradient": "from-emerald-500 to-teal-600",
        "bg": "bg-emerald-500"
      },
      "cadence": {
        "color": "#8b5cf6",
        "gradient": "from-violet-500 to-purple-600",
        "bg": "bg-violet-500"
      }
    },
    "status": {
      "bon": {
        "color": "#10b981",
        "bg": "bg-emerald-500",
        "label": "Excellent"
      },
      "moyen": {
        "color": "#f59e0b",
        "bg": "bg-amber-500",
        "label": "Correct"
      },
      "faible": {
        "color": "#f97316",
        "bg": "bg-orange-500",
        "label": "À améliorer"
      },
      "critique": {
        "color": "#ef4444",
        "bg": "bg-red-500",
        "label": "Critique"
      }
    },
    "text": {
      "dark": {
        "primary": "text-white",
        "secondary": "text-white/70",
        "muted": "text-white/40"
      },
      "light": {
        "primary": "text-slate-900",
        "secondary": "text-slate-600",
        "muted": "text-slate-400"
      }
    },
    "decorative": {
      "blobs": {
        "teal": "bg-teal-500/20",
        "cyan": "bg-cyan-500/15",
        "blur": "blur-[150px]"
      }
    }
  },
  "typography": {
    "headings": {
      "hero": "text-4xl md:text-5xl lg:text-6xl font-black leading-tight",
      "h1": "text-3xl sm:text-4xl md:text-5xl font-black",
      "h2": "text-xl sm:text-2xl font-bold",
      "h3": "text-lg font-bold",
      "gradient": "text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-400"
    },
    "body": {
      "large": "text-xl leading-relaxed",
      "default": "text-lg leading-relaxed",
      "small": "text-sm",
      "tiny": "text-xs"
    },
    "special": {
      "score": "text-8xl font-black text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-cyan-500",
      "percentage": "text-3xl font-black"
    }
  },
  "borderRadius": {
    "small": "rounded-lg",
    "default": "rounded-xl",
    "large": "rounded-2xl",
    "extraLarge": "rounded-3xl",
    "full": "rounded-full"
  },
  "shadows": {
    "card": "shadow-xl",
    "cardLarge": "shadow-2xl",
    "button": {
      "default": "shadow-2xl shadow-teal-500/30",
      "hover": "shadow-teal-500/50"
    },
    "glow": {
      "teal": "shadow-lg shadow-teal-500/40"
    }
  },
  "components": {
    "card": {
      "glass": {
        "dark": "bg-white/10 backdrop-blur-sm rounded-xl",
        "light": "bg-white/80 backdrop-blur-xl rounded-3xl shadow-xl border border-white/50"
      },
      "solid": {
        "white": "bg-white rounded-3xl shadow-xl p-8 md:p-10 border border-slate-200"
      }
    },
    "button": {
      "primary": {
        "base": "inline-flex items-center gap-3 bg-gradient-to-r from-teal-500 to-cyan-500 text-white font-bold px-10 py-5 rounded-2xl shadow-2xl shadow-teal-500/30 transition-all",
        "hover": "hover:from-teal-400 hover:to-cyan-400 hover:shadow-teal-500/50 hover:-translate-y-1",
        "size": {
          "small": "px-4 py-2 text-sm rounded-lg",
          "default": "px-6 py-3 rounded-xl",
          "large": "px-10 py-5 text-xl rounded-2xl"
        }
      },
      "secondary": {
        "base": "px-4 py-2 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors text-sm font-medium text-slate-700"
      },
      "ghost": {
        "base": "flex items-center gap-2 px-4 sm:px-6 py-3 rounded-xl font-semibold transition-all text-slate-600 hover:bg-slate-100"
      }
    },
    "input": {
      "base": "w-full px-4 py-3.5 rounded-xl border-2 border-slate-200 outline-none transition-all bg-white",
      "focus": "focus:border-teal-500 focus:ring-4 focus:ring-teal-100",
      "sizes": {
        "large": "text-2xl sm:text-3xl font-bold p-6 rounded-2xl text-center"
      }
    },
    "badge": {
      "base": "inline-flex items-center gap-2 px-5 py-2.5 rounded-full shadow-lg",
      "primary": "bg-gradient-to-r from-teal-500 to-cyan-500 text-white",
      "success": "bg-green-100 text-green-700",
      "status": "text-xs px-2 py-0.5 rounded-full font-semibold text-white"
    },
    "progressBar": {
      "track": "h-3 bg-slate-100 rounded-full overflow-hidden",
      "fill": "h-full rounded-full transition-all duration-1000 ease-out"
    },
    "infoBox": {
      "warning": "bg-amber-500/20 border border-amber-500/30 rounded-xl p-4 text-amber-200 text-sm",
      "note": "bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-4 text-amber-800",
      "example": "flex items-start gap-3 text-slate-500 text-sm sm:text-base leading-relaxed bg-gradient-to-r from-slate-50 to-slate-100 p-4 rounded-xl border border-slate-200"
    },
    "postIt": {
      "colors": [
        "bg-yellow-100 border-yellow-300",
        "bg-pink-100 border-pink-300",
        "bg-blue-100 border-blue-300",
        "bg-green-100 border-green-300",
        "bg-purple-100 border-purple-300",
        "bg-orange-100 border-orange-300"
      ],
      "rotations": [
        "-rotate-2",
        "rotate-1",
        "-rotate-1",
        "rotate-2",
        "-rotate-3",
        "rotate-3"
      ],
      "base": "border-2 p-3 rounded shadow-md transform hover:scale-105 transition-transform cursor-default"
    },
    "logo": {
      "box": "w-16 h-16 bg-gradient-to-br from-teal-400 to-teal-600 rounded-2xl flex items-center justify-center shadow-2xl shadow-teal-500/30",
      "text": "text-white font-black text-2xl"
    },
    "header": {
      "fixed": "fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-slate-200 shadow-sm"
    }
  },
  "animations": {
    "keyframes": {
      "fadeIn": "animate-fadeIn",
      "pulse": "animate-pulse",
      "ping": "animate-ping",
      "bounce": "animate-bounce",
      "spin": "animate-spin"
    },
    "transitions": {
      "default": "transition-all duration-200",
      "medium": "transition-all duration-300",
      "slow": "transition-all duration-500",
      "verySlow": "transition-all duration-700",
      "ultraSlow": "transition-all duration-1000",
      "polygon": "transition-all duration-1500 ease-out"
    },
    "delays": {
      "stagger": {
        "100": "100ms",
        "200": "200ms",
        "300": "300ms"
      }
    },
    "transforms": {
      "hover": {
        "scale": "hover:scale-105",
        "scaleSmall": "hover:scale-[1.02]",
        "scaleMedium": "hover:scale-[1.01]",
        "scaleUp": "scale-110",
        "lift": "hover:-translate-y-1",
        "bounce": "animate-bounce"
      },
      "entry": {
        "fadeUp": "opacity-0 translate-y-8",
        "fadeUpActive": "opacity-100 translate-y-0"
      }
    },
    "decorative": {
      "blob": {
        "animation": "animate-pulse",
        "delayedPulse": "animationDelay: '1s'"
      },
      "glow": {
        "ambient": "w-64 h-64 bg-gradient-to-br from-teal-400/30 to-cyan-400/30 rounded-full blur-3xl animate-pulse"
      }
    }
  },
  "layout": {
    "container": {
      "default": "max-w-3xl mx-auto",
      "large": "max-w-7xl mx-auto",
      "results": "max-w-7xl mx-auto px-4 pb-16"
    },
    "grid": {
      "results": "grid lg:grid-cols-5 gap-8",
      "scores": "grid sm:grid-cols-2 gap-4",
      "stats": "grid grid-cols-3 gap-4",
      "twoCol": "grid grid-cols-2 gap-4"
    },
    "sticky": {
      "sidebar": "lg:sticky lg:top-8 h-fit"
    }
  },
  "boussole": {
    "svg": {
      "viewBox": "0 0 480 480",
      "size": "w-full max-w-[480px] h-auto mx-auto"
    },
    "gradients": {
      "radial": {
        "id": "premium-radial",
        "stops": [
          {
            "offset": "0%",
            "color": "#14b8a6",
            "opacity": "0.4"
          },
          {
            "offset": "50%",
            "color": "#0d9488",
            "opacity": "0.2"
          },
          {
            "offset": "100%",
            "color": "#0f766e",
            "opacity": "0.05"
          }
        ]
      },
      "linear": {
        "id": "premium-linear",
        "stops": [
          {
            "offset": "0%",
            "color": "#14b8a6"
          },
          {
            "offset": "50%",
            "color": "#06b6d4"
          },
          {
            "offset": "100%",
            "color": "#14b8a6"
          }
        ]
      }
    },
    "filters": {
      "glow": "feGaussianBlur stdDeviation='8'",
      "dropShadow": "feDropShadow dx='0' dy='2' stdDeviation='3' floodColor='#0d9488' floodOpacity='0.3'"
    },
    "geometry": {
      "center": 240,
      "radius": 140,
      "outerRing": 170,
      "labelDistance": 195,
      "gridCircles": [
        100,
        75,
        50,
        25
      ]
    }
  },
  "contact": {
    "section": {
      "gradient": "bg-gradient-to-br from-teal-500 to-cyan-600 rounded-[2rem] p-10 md:p-16 text-white",
      "decorative": "absolute -top-20 -right-20 w-80 h-80 bg-white/10 rounded-full blur-3xl"
    },
    "embed": {
      "hubspot": {
        "container": "meetings-iframe-container",
        "dataSrc": "https://meetings.hubspot.com/yoan-lureault/rdv-telephonique-avec-yoan-lureault?embed=true",
        "script": "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js",
        "strategy": "lazyOnload"
      }
    }
  },
  "blurOverlay": {
    "base": "absolute inset-0 z-10 flex flex-col items-center justify-center rounded-xl overflow-hidden",
    "backdrop": "backdrop-blur-[3px] bg-gradient-to-b from-white/40 via-white/70 to-white/40",
    "decorativeDots": {
      "container": "absolute inset-4 flex flex-col gap-3 opacity-20 pointer-events-none",
      "dot": "h-3 bg-slate-300 rounded animate-pulse",
      "widths": [
        "w-3/4",
        "w-1/2",
        "w-2/3"
      ]
    },
    "lockIcon": {
      "container": "w-10 h-10 rounded-full bg-teal-50 flex items-center justify-center mb-1",
      "path": "M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
    },
    "cta": {
      "button": "flex items-center gap-2 px-4 py-2 bg-white hover:bg-teal-50 text-teal-600 text-sm font-medium rounded-lg shadow-sm border border-teal-200 hover:border-teal-300 transition-all hover:shadow-md"
    }
  }
}